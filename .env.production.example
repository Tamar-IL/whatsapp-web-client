# =============================================================================
# Production env for the Docker Compose stack.  Copy to `.env` on the server:
#     cp .env.production.example .env
# then fill in every value marked CHANGE_ME.  This file is read by
# docker-compose.yml (Postgres, the app, and Caddy all pull from it).
#
# NEVER commit the real .env — it holds secrets. Only this .example is tracked.
# =============================================================================

# ---- Runtime ----------------------------------------------------------------
NODE_ENV=production
PORT=3000

# Public URL the app is reached at. Must match how the browser and Twilio see it.
#   IP-only phase (self-signed HTTPS):  https://<your-server-ip>
#   With a domain:                      https://chat.example.com
# CRITICAL: this is used to verify Twilio webhook signatures, so it must be exact.
PUBLIC_BASE_URL=https://CHANGE_ME

# ---- Reverse proxy / TLS (consumed by Caddy) --------------------------------
# IP-only phase (no domain yet):
SITE_ADDRESS=:443
TLS_OPTS=internal
# Once DNS points at the server, switch to:
#   SITE_ADDRESS=chat.example.com
#   TLS_OPTS=you@example.com

# ---- Database (Postgres runs in the compose stack) --------------------------
# DATABASE_URL is assembled automatically by docker-compose.yml from these three.
POSTGRES_USER=wweb
POSTGRES_PASSWORD=CHANGE_ME_strong_db_password
POSTGRES_DB=wweb

# ---- Auth -------------------------------------------------------------------
# Generate: openssl rand -base64 32
SESSION_SECRET=CHANGE_ME_32_bytes_base64
CSRF_COOKIE_NAME=wweb_csrf

# Bootstrap admin (created/updated on every boot when both are set).
# Generate the hash with:  docker compose run --rm app npm run hash-password
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD_HASH=CHANGE_ME

# ---- Twilio -----------------------------------------------------------------
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=CHANGE_ME
TWILIO_CONVERSATION_SERVICE_SID=ISxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_WHATSAPP_SENDER=whatsapp:+15555555555

# ---- Storage ----------------------------------------------------------------
# Path inside the container; a named volume is mounted here by compose.
MEDIA_STORAGE_PATH=/app/apps/backend/storage
MEDIA_MAX_BYTES=209715200

# ---- Outgoing email ("email me this recording") -----------------------------
# Zoho SMTP. This is the transport the app uses whenever SMTP_USER and SMTP_PASS
# are BOTH set (it takes priority over RESEND_API_KEY below).
#   SMTP_PASS must be a Zoho APP-SPECIFIC password if 2FA is on the account
#   (Zoho > My Account > Security > App Passwords) — not the login password.
#   Zoho EU accounts: SMTP_HOST=smtp.zoho.eu
# Verify with:  docker compose run --rm app npm run mail-check
#
# PORT 587, NOT 465: Hetzner blocks outbound ports 25 and 465 by default on all
# cloud servers (anti-spam); 587 is open. On 465 the connection simply times out
# before any login is attempted. 587 uses STARTTLS, hence SMTP_SECURE=false.
# Hetzner will unblock 465 on request once the account is ~1 month old with a
# paid invoice, but there is no reason to need it — 587 is equivalent.
SMTP_HOST=smtp.zoho.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Must be an address Zoho lets this account send as — normally exactly SMTP_USER.
# MAIL_FROM=
MEDIA_EMAIL_TO=swenlly123@gmail.com

# ---- Optional integrations --------------------------------------------------
# GROQ_API_KEY=            # Whisper transcription
# RESEND_API_KEY=          # email fallback, only used if SMTP above is unset
# MAKE_WEBHOOK_URL=        # forward inbound media

# ---- Logging / proxy --------------------------------------------------------
LOG_LEVEL=info
# One proxy hop (Caddy) sits in front of the app.
TRUST_PROXY=1
