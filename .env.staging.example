# =============================================================================
# STAGING (test) env — copy to `.env.staging` in the STAGING checkout folder:
#     cp .env.staging.example .env.staging
# Read by docker-compose.staging.yml. Use DIFFERENT secrets, database password
# and Twilio sender than production. Guide: docs/05-staging.md
#
# NEVER commit the real .env — it holds secrets. Only this .example is tracked.
# =============================================================================

# ---- Runtime ----------------------------------------------------------------
NODE_ENV=production
PORT=3000

# Public URL the app is reached at. Must match how the browser and Twilio see it.
#   IP-only phase (self-signed HTTPS):  https://<your-server-ip>
#   With a domain:                      https://chat.example.com
# CRITICAL: this is used to verify Twilio webhook signatures, so it must be exact.
PUBLIC_BASE_URL=https://staging.CHANGE_ME

# Shown as a coloured bar at the top of the app so the test copy can never be
# mistaken for the real one.
ENV_LABEL=TEST

# (No Caddy settings here: the production Caddy serves the staging domain via
#  deploy/sites/staging.caddy.)

# ---- Database (Postgres runs in the compose stack) --------------------------
# DATABASE_URL is assembled automatically by docker-compose.yml from these three.
POSTGRES_USER=wweb_staging
POSTGRES_PASSWORD=CHANGE_ME_other_db_password
POSTGRES_DB=wweb_staging

# ---- Auth -------------------------------------------------------------------
# Generate: openssl rand -base64 32
SESSION_SECRET=CHANGE_ME_32_bytes_base64
CSRF_COOKIE_NAME=wweb_csrf

# Bootstrap admin (created/updated on every boot when both are set).
# Generate the hash with:  ./deploy/staging.sh hash
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD_HASH=CHANGE_ME

# ---- Twilio -----------------------------------------------------------------
# Use the Twilio WhatsApp SANDBOX here, never the real business number: a number
# has only one inbound webhook, and it belongs to production.
#   Twilio Console → Messaging → Try it out → Send a WhatsApp message.
#   Sandbox sender is usually whatsapp:+14155238886. In "Sandbox settings" set
#   "When a message comes in" to https://staging.<your-domain>/webhooks/twilio/inbound
#   and the status callback to .../webhooks/twilio/status.
#   Each test phone joins once by sending "join <code>" to the sandbox number.
# Same account SID / auth token as production is fine.
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=CHANGE_ME
TWILIO_CONVERSATION_SERVICE_SID=ISxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_WHATSAPP_SENDER=whatsapp:+14155238886

# Country calling code (digits, no "+") used when starting a NEW chat from a
# locally-typed number: "0501234567" becomes "+972501234567". Numbers typed with
# a leading "+" are used exactly as given and ignore this.
DEFAULT_COUNTRY_CODE=972

# ---- Storage ----------------------------------------------------------------
# Path inside the container; a named volume is mounted here by compose.
MEDIA_STORAGE_PATH=/app/apps/backend/storage
MEDIA_MAX_BYTES=209715200

# ---- Outgoing email ("email me this recording") -----------------------------
# Zoho SMTP. This is the transport the app uses whenever SMTP_USER and SMTP_PASS
# are BOTH set (it takes priority over RESEND_API_KEY below).
#   SMTP_PASS must be a Zoho APP-SPECIFIC password if 2FA is on the account
#   (Zoho > My Account > Security > App Passwords) — not the login password.
#   Zoho EU accounts: SMTP_HOST=smtp.zoho.eu
#
# PORT 587, NOT 465: Hetzner blocks outbound ports 25 and 465 by default on all
# cloud servers (anti-spam); 587 is open. On 465 the connection simply times out
# before any login is attempted. 587 uses STARTTLS, hence SMTP_SECURE=false.
# Hetzner will unblock 465 on request once the account is ~1 month old with a
# paid invoice, but there is no reason to need it — 587 is equivalent.
SMTP_HOST=smtp.zoho.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Must be an address Zoho lets this account send as — normally exactly SMTP_USER.
# MAIL_FROM=
MEDIA_EMAIL_TO=swenlly123@gmail.com

# ---- Optional integrations --------------------------------------------------
# GROQ_API_KEY=            # Whisper transcription
# OPENAI_API_KEY=          # AI agent — consider a separate key with a low spending limit
# RESEND_API_KEY=          # email fallback, only used if SMTP above is unset
# MAKE_WEBHOOK_URL=        # leave unset in staging unless you have a test scenario

# ---- Logging / proxy --------------------------------------------------------
LOG_LEVEL=info
# One proxy hop (Caddy) sits in front of the app.
TRUST_PROXY=1
