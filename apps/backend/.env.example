# ===== Runtime =====
NODE_ENV=development
PORT=3000

# Public base URL of the deployed app.
# CRITICAL: used to verify Twilio webhook signatures. In production this MUST
# match the URL configured in Twilio (your Netfree-approved custom domain).
# In local dev, set this to your ngrok URL.
PUBLIC_BASE_URL=http://localhost:3000

# Origin allowed by CORS for the frontend dev server.
# In production frontend is served by the backend, so only the same origin is allowed.
FRONTEND_ORIGIN=http://localhost:5173

# Base URL Twilio uses to fetch OUTBOUND media files. Set this to your raw Railway
# domain (https://<service>.up.railway.app) so Twilio's media fetcher bypasses
# Cloudflare (which otherwise blocks it -> Twilio error 63019). If unset, the app
# falls back to RAILWAY_PUBLIC_DOMAIN, then PUBLIC_BASE_URL.
# MEDIA_PUBLIC_BASE_URL=https://your-service.up.railway.app

# ===== Database =====
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/wweb?schema=public

# ===== Auth =====
# Generate with: openssl rand -base64 32  (or in PowerShell: [Convert]::ToBase64String((1..32 | ForEach-Object { Get-Random -Maximum 256 })))
SESSION_SECRET=replace-me-with-32-bytes-of-random
# Required for CSRF double-submit cookie
CSRF_COOKIE_NAME=wweb_csrf

# Bootstrap admin user (created/updated on every boot if both present).
# Generate ADMIN_PASSWORD_HASH with: npm run hash-password
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD_HASH=

# ===== Twilio =====
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=
TWILIO_CONVERSATION_SERVICE_SID=ISxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_WHATSAPP_SENDER=whatsapp:+15555555555

# ===== Storage =====
# Local path for media (set to a Railway Volume mount in production).
MEDIA_STORAGE_PATH=./storage
MEDIA_MAX_BYTES=104857600

# ===== Outgoing email (Zoho SMTP) =====
# Used by the "email me this recording" button so files bypass the NetFree
# download block. Sending needs SMTP (NOT IMAP). For Zoho:
SMTP_HOST=smtp.zoho.com
SMTP_PORT=465
# Leave SMTP_SECURE unset to auto-pick (true for 465, false for 587).
# SMTP_SECURE=true
# Your Zoho address and an APP-SPECIFIC password (generate one in Zoho if 2FA is on).
SMTP_USER=
SMTP_PASS=
# From address shown on the email (defaults to SMTP_USER if blank).
# MAIL_FROM=
# Where recordings get emailed to.
MEDIA_EMAIL_TO=swenlly123@gmail.com

# ===== Logging =====
LOG_LEVEL=info

# ===== Optional =====
# Comma-separated list of trusted proxies for express.set('trust proxy', ...)
# On Railway leave blank to trust the first proxy hop.
TRUST_PROXY=1
